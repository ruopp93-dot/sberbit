# ─── Обязательные ────────────────────────────────────────────────────────────
# Upstash Redis — хранилище заявок, курсов и настроек.
# В Vercel: Storage → Create → Upstash (Redis) → Connect Project — переменные
# KV_REST_API_URL / KV_REST_API_TOKEN добавятся автоматически. Можно и так:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telegram-бот (админка): токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID администраторов (узнать: @userinfobot). Несколько — через запятую.
TELEGRAM_ADMIN_CHAT_ID=
# Необязательно: секрет вебхука бота (латиница/цифры). Без него выводится из токена.
# TELEGRAM_WEBHOOK_SECRET=

# ─── Необязательные ─────────────────────────────────────────────────────────
# Адрес сайта. Без своего домена не нужен: берётся *.vercel.app адрес проекта.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Реквизиты по умолчанию (дальше меняются в боте: 💳 Реквизиты)
# PAYMENT_DETAILS=https://dalink.to/sberbits_com_ru

# Курсы по умолчанию, пока не получены курсы с биржи (₽ за 1 монету)
# DEFAULT_BTC_RATE=3500000
# DEFAULT_ETH_RATE=180000
# DEFAULT_USDT_RATE=95.45

# Email-уведомления клиентам (SMTP)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# FROM_EMAIL=SberBits <support@example.com>
