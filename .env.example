# PostgreSQL (Supabase / Neon / Prisma Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Pally API
PALLY_API_URL="https://pal24.pro/api/v1"
PALLY_API_TOKEN="YOUR_PALLY_API_TOKEN"
PALLY_SHOP_ID="YOUR_PALLY_SHOP_ID"
PALLY_CURRENCY="RUB"
PALLY_PAYER_PAYS_COMMISSION="1"

# Public site URL
NEXT_PUBLIC_SITE_URL="https://sberbits.com.ru"

# Existing Telegram notifications
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_BOT_TOKEN=""

# Admin dashboard. Never commit the real password.
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD"

