# Database
DATABASE_URL=

# Pally payment provider
PALLY_API_URL=
PALLY_API_TOKEN=
# Обязателен: без него вебхук оплаты отклоняет все запросы
PALLY_WEBHOOK_SECRET=

# Application
NEXT_PUBLIC_URL=https://sberbits.com.ru
NEXT_PUBLIC_SITE_URL=https://sberbits.com.ru

# Admin
ADMIN_LOGIN=
# Минимум 12 символов (используется только в prisma/seed.ts)
ADMIN_PASSWORD=
# Секрет подписи админ-сессий, минимум 32 символа (openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
# Обязателен в production: только этот чат получает права администратора бота
TELEGRAM_ADMIN_CHAT_ID=
# Обязателен в production: проверяется заголовок X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# Rate limiting: сколько доверенных прокси стоит перед приложением (вне Vercel).
# Приложение должно работать за прокси, который дописывает X-Forwarded-For.
TRUSTED_PROXY_HOPS=1
