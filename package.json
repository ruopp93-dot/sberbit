{
  "name": "sberbit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npx --yes prisma@6.15.0 generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "npx --yes prisma@6.15.0 generate",
    "prisma:migrate": "npx --yes prisma@6.15.0 migrate dev",
    "prisma:deploy": "npx --yes prisma@6.15.0 migrate deploy",
    "prisma:seed": "npx --yes prisma@6.15.0 db seed",
    "postinstall": "npx --yes prisma@6.15.0 generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@prisma/client": "^6.15.0",
    "@tanstack/react-query": "^5.85.6",
    "@upstash/redis": "^1.37.0",
    "axios": "^1.11.0",
    "coingecko-api-v3": "^0.0.31",
    "decimal.js": "^10.6.0",
    "grammy": "^1.38.1",
    "next": "15.5.12",
    "node-telegram-bot-api": "^0.66.0",
    "nodemailer": "^7.0.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.62.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}
